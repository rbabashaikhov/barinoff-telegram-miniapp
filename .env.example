# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
PORT=3000

# SQLite path (local default created under backend/data)
# Railway / Docker production: /data/booking.db with a persistent volume mounted at /data
DATABASE_PATH=

# Telegram Bot token from @BotFather (required for production initData validation)
TELEGRAM_BOT_TOKEN=

# When true (or when TELEGRAM_BOT_TOKEN is empty), browser demo mode is allowed
# without valid Telegram initData. Demo user is used for local testing.
ALLOW_DEMO_MODE=true

# Timezone used for slot calculation and "future only" checks
TZ=Europe/Moscow

# Optional override for static frontend directory (production single-service)
PUBLIC_DIR=

# Frontend API base URL.
# Leave empty to use same-origin /api (Vite proxy in dev, single-service / nginx in prod).
# Set to http://localhost:3000 only if the UI talks to the API directly.
VITE_API_URL=

# White-label (single business per deployment)
BUSINESS_NAME=BARINOFF
BUSINESS_TYPE=барбершоп
APP_TITLE=Барбершоп Barinoff
APP_DESCRIPTION=Мы просто стрижём мужчин и делаем это превосходно.

# Admin protection.
# Production: empty token locks /api/admin (fail-closed). Set a secret to use the console.
# Local/dev: empty token keeps /admin open for convenience.
ADMIN_TOKEN=

# CRM integration. local = demo SQLite only (default). webhook = POST normalized events.
CRM_ADAPTER=local
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_TIMEOUT_MS=5000
CRM_SYNC_ON_STARTUP=false

# Booking POST rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Sales Demo Mode (browser demo). Set false for a live client deployment.
FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true
